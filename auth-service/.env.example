# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edoms_auth
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Shared across all services - must be IDENTICAL everywhere or JWTs fail
JWT_SECRET=change_me_to_a_long_random_string

# RabbitMQ (defaults to amqp://localhost:5672 when unset)
BROKER_URL=amqp://localhost:5672

NODE_ENV=development

# Server
PORT=5000
