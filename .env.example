# Root .env, used by docker-compose only.
#
# The per-service .env files are for running on the host with `npm run dev`;
# compose passes these into the containers instead.
#
# Copy to .env and fill in. The two secrets have no defaults on purpose -
# compose refuses to start without them rather than silently using a
# placeholder that would reject every token.

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SERVICE_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_TEST_PAYMENT_METHOD=pm_card_visa
# From `stripe listen --forward-to localhost:5004/webhooks/stripe`, or the
# dashboard under Developers > Webhooks. Without it the webhook refuses to act.
STRIPE_WEBHOOK_SECRET=

POSTGRES_PASSWORD=postgres

# Host ports, if something already uses the defaults.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379

# Traces go nowhere unless this is set; see docs/OBSERVABILITY.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
