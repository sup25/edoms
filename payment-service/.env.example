# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edoms_payment
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Shared across all services - must be IDENTICAL everywhere or JWTs fail

# RabbitMQ (defaults to amqp://localhost:5672 when unset)
BROKER_URL=amqp://localhost:5672

NODE_ENV=development

# Server
PORT=5004

# Stripe - use TEST keys only (sk_test_...). Never commit a live key.
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_TEST_PAYMENT_METHOD=pm_card_visa

# Downstream services
ORDER_SERVICE_URL=http://localhost:5003/api/v1/order
INVENTORY_SERVICE_URL=http://localhost:5002/api/v1/reservedstock

# --- Observability (Phase 6) ---
# LOG_LEVEL   error | warn | info | debug. Defaults to debug, or info when
#             NODE_ENV is exactly "production".
# LOG_FORMAT  json forces machine-readable logs; anything else is the pretty
#             dev format. Defaults to json when NODE_ENV=production.
LOG_LEVEL=debug
LOG_FORMAT=pretty

# How often the queue monitor samples queue and dead-letter depth.
QUEUE_MONITOR_POLL_MS=15000

# Tracing is OFF unless one of these is set. See docs/OBSERVABILITY.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_CONSOLE=1

# --- Security (Phase 8) ---
# JWT_SECRET must be IDENTICAL across all five services: auth-service signs,
# the others verify. At least 16 characters; boot fails otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-value

# Shared secret peer services present as `x-service-token` when calling each
# other's internal endpoints. Same value in every service. At least 16 chars.
SERVICE_TOKEN=replace-me-with-a-long-random-value

# Stripe webhook signing secret (Phase 8). The webhook endpoint refuses to act
# without it - accepting unverified instructions about money is worse than
# being unavailable.
#   stripe listen --forward-to localhost:5004/webhooks/stripe
# prints one; in the dashboard it is under Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
