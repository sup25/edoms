# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edoms_product
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Shared across all services - must be IDENTICAL everywhere or JWTs fail
JWT_SECRET=change_me_to_a_long_random_string

# RabbitMQ (defaults to amqp://localhost:5672 when unset)
BROKER_URL=amqp://localhost:5672

NODE_ENV=development

# Server
PORT=5001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Downstream services
INVENTORY_SERVICE_URL=http://localhost:5002/api/v1
